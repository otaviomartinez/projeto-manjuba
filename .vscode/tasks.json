{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar programa",
      "type": "shell",
      "command": "gcc",
      "args": [
        "${workspaceFolder}\\src\\*.c",
        "-Wall",
        "-g",
        "-o",
        "${workspaceFolder}\\programa.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}